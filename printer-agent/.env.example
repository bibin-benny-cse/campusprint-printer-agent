# CampusPrint Printer Agent Configuration
# Set the backend URL (default points to Render live backend or http://localhost:3001/api for local development)
API_URL=https://campusprint-backend-bl6p.onrender.com/api

# Name of target printer registered in Windows & CampusPrint backend
# Set to "auto" (default) to automatically detect your connected Windows default printer,
# or specify exact printer name (e.g. PRINTER_NAME=EPSON L3150 Series)
PRINTER_NAME=auto
