<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>XeroxGo.PrinterAgent.Program</StartupObject>
    <AssemblyName>XeroxGo.PrinterAgent</AssemblyName>
    <RootNamespace>XeroxGo.PrinterAgent</RootNamespace>
    
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>XeroxGo Agent</Product>
    <Company>XeroxGo Technologies</Company>
    
    <!-- Self-Contained Single-File Publish Configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Extreme Memory Optimization for 24/7 Background Tray Daemon -->
    <!-- Enable .NET 8 DATAS (Dynamic Adaptation to Application Sizes) -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <!-- Cap GC Heap for low-footprint desktop agent (32 MB) -->
    <DOTNET_GCHeapHardLimit>0x2000000</DOTNET_GCHeapHardLimit>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDF processing for 2-Up imposition, page rotation, exclusion and reordering -->
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <!-- Native Windows Spooler & GDI+ Printing -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\logo.png" />
    <EmbeddedResource Include="Resources\logo_glyph.png" />
    <EmbeddedResource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
